# Desarrollo local: `npm run db:dev` (prisma dev: Postgres local sin Docker, una sola base).
# La base "shadow" que usa `prisma migrate dev` está en otro puerto del mismo servidor.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"
# Código de acceso compartido (obligatorio en producción). En desarrollo, vacío = no se pide.
ACCESO_CODIGO=""

# Producción (Vercel): DATABASE_URL = connection string *pooled* de Neon; sin SHADOW_DATABASE_URL.
